# dependências
node_modules/

# saída do build
_site/
public/

# artefatos gerados dentro de src (libs vendorizadas são versionadas junto)
src/assets/static/app.js
src/assets/static/app.js.map
src/assets/static/app.css
src/assets/static/app.css.map

# carimbo dos assets, gravado pelo esbuild (dispara o rebuild no dev)
dev/

# cache do Eleventy
.cache/
.tmp-tests/

# rascunhos: o build também ignora esta pasta (src/_lib/content.js).

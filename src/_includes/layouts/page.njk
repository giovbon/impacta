{% extends "layouts/base.njk" %}

{# reveal.js só é carregado nas páginas que têm deck #}
{% block head %}
  {% if item.frontmatter.presentation %}
    <link rel="stylesheet" href="{{ '/static/lib/reveal/reveal.css' | link }}" />
    <link rel="stylesheet" href="{{ '/static/lib/reveal/black.css' | link }}" />
    <script src="{{ '/static/lib/reveal/reveal.js' | link }}"></script>
    <script src="{{ '/static/lib/reveal/plugin/markdown/markdown.js' | link }}"></script>
    <script src="{{ '/static/lib/reveal/plugin/highlight/highlight.js' | link }}"></script>
  {% endif %}
  {# highlight.js: o deck (plugin do reveal) e o explorador de código precisam dele #}
  {% if item.frontmatter.codes or item.frontmatter.presentation %}
    <script src="{{ '/static/lib/reveal/highlight.min.js' | link }}"></script>
  {% endif %}
  {# asciinema: só o CSS (leve); o player (155 KB) é baixado quando alguém abre uma gravação #}
  {% if item.frontmatter.asciinema %}
    <link rel="stylesheet" href="{{ '/static/lib/asciinema/asciinema-player.css' | link }}" />
  {% endif %}
{% endblock %}

{% block content %}
  <h1 class="page-title">{{ item.title }}</h1>

  {# Componentes acionados pelo frontmatter (1 chave = 1 componente).
     Cada um devolve "" quando a chave não existe, então podem ficar soltos aqui. #}
  {# Ordem de leitura: visão geral (deck, mapa) → terminal → exercício → markdown → código #}
  {{ item.frontmatter | presentation | safe }}
  {{ item.frontmatter | markmap | safe }}
  {{ item.frontmatter | asciinema | safe }}
  {{ item.frontmatter | typst | safe }}
  {{ item.frontmatter | codes | safe }}

  <article class="prose">
    {{ item.html | safe }}
  </article>

  {# O quiz vem depois da leitura: o aluno revisa o conteúdo e se autoavalia. #}
  {{ item.frontmatter | quiz | safe }}

  {# A entrega vem depois do conteúdo: o aluno lê o exercício e envia #}
  {{ item.frontmatter | submission | safe }}
{% endblock %}
